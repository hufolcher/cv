// Brand hues, muted for a sober print look. Tune the percentages, not the hex codes.
#let green = rgb("#31a269").desaturate(20%)
#let blue = rgb("#1f4e95").desaturate(15%)
#let grey = rgb(80, 80, 80)

#let navy = rgb("#071829").desaturate(20%)
#let navy-light = rgb("#113454").desaturate(20%)

#let brand-gradient = gradient.linear(green, blue)
